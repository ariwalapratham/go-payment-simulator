# Required
PRIMARY_ENV=development

SERVER_PORT=8080
SERVER_READ_TIMEOUT=5
SERVER_WRITE_TIMEOUT=10
SERVER_IDLE_TIMEOUT=60
SERVER_CORS_ALLOWED_ORIGINS=http://localhost:3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=payments
DATABASE_SSL_MODE=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=25
DATABASE_CONN_MAX_LIFETIME=300
DATABASE_CONN_MAX_IDLE_TIME=60

# Optional (New Relic is off when license_key is empty)
# OBSERVABILITY_NEW_RELIC_LICENSE_KEY=
# OBSERVABILITY_NEW_RELIC_APP_LOG_FORWARDING_ENABLED=true
# OBSERVABILITY_NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
# OBSERVABILITY_NEW_RELIC_DEBUG_LOGGING=false
# OBSERVABILITY_LOGGING_LEVEL=info
# OBSERVABILITY_LOGGING_FORMAT=json