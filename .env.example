# Required (PAYMENTS_ prefix matches internal/config LoadConfig)
PAYMENTS_PRIMARY_ENV=development

PAYMENTS_SERVER_PORT=8080
PAYMENTS_SERVER_READ_TIMEOUT=5
PAYMENTS_SERVER_WRITE_TIMEOUT=10
PAYMENTS_SERVER_IDLE_TIMEOUT=60
PAYMENTS_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:3000

PAYMENTS_DATABASE_HOST= localhost
PAYMENTS_DATABASE_PORT=5432
PAYMENTS_DATABASE_USER=postgres
PAYMENTS_DATABASE_PASSWORD=postgres
PAYMENTS_DATABASE_NAME=payments
PAYMENTS_DATABASE_SSL_MODE=disable
PAYMENTS_DATABASE_MAX_OPEN_CONNS=25
PAYMENTS_DATABASE_MAX_IDLE_CONNS=25
PAYMENTS_DATABASE_CONN_MAX_LIFETIME=300
PAYMENTS_DATABASE_CONN_MAX_IDLE_TIME=60

# Optional bank (defaults: simulator 90/5/3/2, 30s authorize timeout)
# PAYMENTS_BANK_PROVIDER=simulator
# PAYMENTS_BANK_CALL_TIMEOUT=30
# PAYMENTS_BANK_SIMULATOR_SUCCESS_PCT=90
# PAYMENTS_BANK_SIMULATOR_DECLINED_PCT=5
# PAYMENTS_BANK_SIMULATOR_TIMEOUT_PCT=3
# PAYMENTS_BANK_SIMULATOR_FAILURE_PCT=2
# PAYMENTS_BANK_SIMULATOR_MIN_DELAY_MS=0
# PAYMENTS_BANK_SIMULATOR_MAX_DELAY_MS=0

# Optional observability (defaults apply when unset)
# PAYMENTS_OBSERVABILITY_LOGGING_LEVEL=info
# PAYMENTS_OBSERVABILITY_LOGGING_FORMAT=json
# PAYMENTS_OBSERVABILITY_NEW_RELIC_LICENSE_KEY=
